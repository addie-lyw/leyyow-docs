{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Leyyow Docs",
  "colors": {
    "primary": "#d69000",
    "light": "#d69000",
    "dark": "#d69000"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "tabs": [
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "APIs",
            "openapi": "openapi.yaml"
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hi@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "footer": {
    "socials": {
      "linkedin": "https://linkedin.com/company/leyyow",
      "instagram": "https://instagram.com/leyyowhq"
    }
  },
  "markdown": {
    "schema": true
  },
  "icons": {
    "library": "fontawesome"
  },
  "background": {
    "decoration": "windows"
  },
  "api": {
    "openapi": "openapi.yaml"
  },
  "appearance": {
    "default": "dark"
  }
}
